# AI receptionist (server-side only; never prefix these with VITE_).
# Local development: copy to .env.local and fill in. Production: add them in
# Vercel -> Project -> Settings -> Environment Variables.

# Required. An Anthropic API key (sk-ant-...) or a Google Gemini API key (AIza... / AQ....).
# Without it the chat still gives emergency guidance and reception hand-off, and shows a
# "temporarily unavailable" message for everything else.
AI_API_KEY=

# Optional. "anthropic" or "gemini". If empty, it is inferred from the key format.
AI_PROVIDER=

# Optional. Model ID. Defaults: claude-opus-5 (Anthropic), gemini-flash-latest (Gemini).
AI_MODEL=

# Optional. Reasoning effort: low | medium | high (default: low, best for chat latency).
AI_EFFORT=

# Optional. Extra origins allowed to call /api/chat, comma-separated
# (e.g. a custom domain served through a proxy). Same-origin requests are always allowed.
AI_ALLOWED_ORIGINS=
